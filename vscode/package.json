{
  "name": "hisccs",
  "displayName": "HisCCS",
  "author": {
    "name": "HisCCS"
  },
  "description": "AI-powered Git commit message generator using DeepSeek / 通义千问 / OpenAI",
  "version": "1.3.0",
  "publisher": "sunfleeting108",
  "license": "MIT",
  "keywords": [
    "git",
    "commit",
    "ai",
    "deepseek",
    "conventional commits",
    "openai",
    "qwen"
  ],
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CSU-OSS/CMG-VSCode"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cmg-vscode.selectCommitType",
        "title": "CMG: Select Commit Type",
        "icon": "$(tag)"
      },
      {
        "command": "cmg-vscode.autocomplete",
        "title": "CMG: Autocomplete Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "cmg-vscode.autofill",
        "title": "CMG: Generate Commit Message"
      },
      {
        "command": "cmg-vscode.openSettings",
        "title": "CMG: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cmg-vscode.viewCommitHistory",
        "title": "CMG: View Commit History",
        "icon": "$(history)"
      },
      {
        "command": "cmg-vscode.openChat",
        "title": "CMG: Open AI Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "cmg-vscode.autocomplete",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "cmg-vscode.selectCommitType",
          "when": "scmProvider == git",
          "group": "navigation@2"
        },
        {
          "command": "cmg-vscode.autofill",
          "when": "scmProvider == git",
          "group": "navigation@3"
        },
        {
          "command": "cmg-vscode.openSettings",
          "when": "scmProvider == git",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hisccs",
          "title": "HisCCS",
          "icon": "images/logo.png"
        }
      ]
    },
    "views": {
      "hisccs": [
        {
          "type": "webview",
          "id": "hisccs.settingsView",
          "name": "Settings"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "HisCCS - AI Commit Message",
      "properties": {
        "cmg.apiKey": {
          "type": "string",
          "default": "",
          "description": "AI API Key（DeepSeek / 通义千问 / OpenAI 等）",
          "markdownDescription": "你的 AI 模型 API Key，支持 [DeepSeek](https://platform.deepseek.com/)、[通义千问](https://help.aliyun.com/zh/model-studio/getting-started/models)、[OpenAI](https://platform.openai.com/api-keys) 等兼容接口"
        },
        "cmg.provider": {
          "type": "string",
          "default": "deepseek",
          "enum": [
            "deepseek",
            "qwen",
            "openai"
          ],
          "markdownDescription": "AI 模型提供商\n- `deepseek` — 默认，使用 deepseek-chat 模型\n- `qwen` — 通义千问，使用 qwen-plus 模型\n- `openai` — OpenAI 兼容接口",
          "enumDescriptions": [
            "DeepSeek (deepseek-chat)",
            "通义千问 (qwen-plus)",
            "OpenAI 兼容 (gpt-4o-mini)"
          ]
        },
        "cmg.apiEndpoint": {
          "type": "string",
          "default": "",
          "description": "（可选）自定义后端服务地址。留空则使用插件内置的 AI 直连模式",
          "markdownDescription": "如果留空，插件会直接调用 AI API（不再需要运行 Python 后端）。如果填写地址（如 `http://127.0.0.1:8000`），则通过你的后端服务转发请求。"
        },
        "cmg.baseUrl": {
          "type": "string",
          "default": "",
          "description": "（可选）自定义 API 地址。留空则使用各提供商默认地址",
          "markdownDescription": "填写后会覆盖提供商默认的 API 地址，例如 `https://api.deepseek.com`。适用于需要使用 API 中转/代理的场景。"
        },
        "cmg.modelName": {
          "type": "string",
          "default": "",
          "description": "（可选）自定义模型名。留空则使用各提供商默认模型",
          "markdownDescription": "填写后会覆盖提供商默认的模型名，例如 `deepseek-chat`、`gpt-4o` 等。使用自定义 API 地址时通常需要同步修改此项。"
        },
        "cmg.prefixMode": {
          "type": "string",
          "default": "standard",
          "enum": [
            "standard",
            "custom"
          ],
          "markdownDescription": "Commit message 前缀模式\n- `standard` — 从 Conventional Commits 类型中选取，或由 AI 自动选择\n- `custom` — 自定义前缀，AI 理解语义后生成"
        },
        "cmg.standardPrefix": {
          "type": "string",
          "default": "",
          "markdownDescription": "标准模式下的固定前缀类型。留空则 AI 自动选择。可选值：feat / fix / docs / style / refactor / perf / test / chore / revert"
        },
        "cmg.customPrefix": {
          "type": "string",
          "default": "",
          "description": "自定义前缀（prefixMode 为 custom 时生效），AI 会理解该前缀语义并据此生成描述"
        },
        "cmg.suggestionCount": {
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 10,
          "description": "生成时提供的候选 commit message 数量（2~10）"
        },
        "cmg.AccordingHistoryOrNot": {
          "type": "boolean",
          "default": false,
          "description": "生成时是否参考最近 10 条历史提交消息的风格？"
        },
        "cmg.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "模型输出随机性（0~1，越高越有创意）"
        },
        "cmg.max_tokens": {
          "type": "integer",
          "default": 200,
          "description": "最大输出 token 数"
        },
        "cmg.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh",
            "en",
            "ja",
            "ru",
            "fr",
            "de"
          ],
          "markdownDescription": "Commit message 生成语言\n- `auto` — 自动（与 VS Code 界面语言一致）\n- `zh` — 中文\n- `en` — English\n- `ja` — 日本語\n- `ru` — Русский\n- `fr` — Français\n- `de` — Deutsch"
        },
        "cmg.uiLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh",
            "en",
            "ja",
            "ru",
            "fr",
            "de"
          ],
          "markdownDescription": "Extension UI display language / 扩展界面显示语言 / 拡張機能の表示言語 / Langue d'interface de l'extension / Язык интерфейса расширения / Erweiterungs-Anzeigesprache\n- `auto` — Match VS Code language\n- `zh` — 中文\n- `en` — English\n- `ja` — 日本語\n- `fr` — Français\n- `ru` — Русский\n- `de` — Deutsch"
        },
        "cmg.nativeTools": {
          "type": "boolean",
          "default": true,
          "description": "在 AI Chat 中启用内置工具（run_command、read_file 等）。关闭后 AI 只能纯文本对话。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test:unit": "tsc -p tsconfig.test.json && mocha out-test/test/unit/*.test.js",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/node-fetch": "2",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "javascript-obfuscator": "^5.5.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-obfuscator": "^3.6.1"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}